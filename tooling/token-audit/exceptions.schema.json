{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claudia.example/schemas/token-audit-exceptions.schema.json",
  "title": "Token audit advisory exceptions",
  "type": "object",
  "required": ["schemaVersion", "exceptions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "metric",
          "approvedValue",
          "reason",
          "supportingCaseIds",
          "reviewDate"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "not": { "pattern": "[*?\\[]" }
          },
          "metric": { "type": "string", "minLength": 1 },
          "approvedValue": { "type": "number", "minimum": 0 },
          "reason": { "type": "string", "minLength": 1 },
          "supportingCaseIds": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "reviewDate": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
