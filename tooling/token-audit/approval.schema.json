{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claudia.example/schemas/token-eval-approval.schema.json",
  "title": "Owner approval for a token evaluation pilot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "approvedBy",
    "approvedAt",
    "model",
    "harness",
    "reasoning",
    "pilotRepetitions",
    "maxFullRunRepetitions",
    "caseIds",
    "conditionIds",
    "budgets",
    "stopCondition",
    "adjudication",
    "unavailableMetrics",
    "permissions",
    "repository",
    "posture"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "token-eval-owner-approval"
    },
    "approvedBy": {
      "type": "string",
      "minLength": 1
    },
    "approvedAt": {
      "type": "string",
      "format": "date-time"
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "name",
        "exactVersion"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "exactVersion": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "adapter",
        "adapterVersion"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "adapter": {
          "type": "string",
          "minLength": 1
        },
        "adapterVersion": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "reasoning": {
      "type": "string",
      "minLength": 1
    },
    "pilotRepetitions": {
      "type": "integer",
      "minimum": 1
    },
    "maxFullRunRepetitions": {
      "type": "integer",
      "minimum": 1
    },
    "caseIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "conditionIds": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxInputTokens",
        "maxOutputTokens",
        "maxTotalTokens",
        "maxCurrency"
      ],
      "properties": {
        "maxInputTokens": {
          "type": "integer",
          "minimum": 1
        },
        "maxOutputTokens": {
          "type": "integer",
          "minimum": 1
        },
        "maxTotalTokens": {
          "type": "integer",
          "minimum": 1
        },
        "maxCurrency": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "amount",
            "currency"
          ],
          "properties": {
            "amount": {
              "type": "number",
              "minimum": 0
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            }
          }
        }
      }
    },
    "stopCondition": {
      "type": "string",
      "minLength": 1
    },
    "adjudication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "identity",
        "version",
        "rubricVersion",
        "blind",
        "doubleScoreCaseIds"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "human",
            "model",
            "mixed"
          ]
        },
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "rubricVersion": {
          "type": "string",
          "minLength": 1
        },
        "blind": {
          "const": true
        },
        "doubleScoreCaseIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "unavailableMetrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "metric",
          "handling",
          "reason"
        ],
        "properties": {
          "metric": {
            "type": "string",
            "minLength": 1
          },
          "handling": {
            "type": "string",
            "enum": [
              "mark-unavailable",
              "exclude-with-explanation"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "fixtureHash",
        "candidateHash",
        "controlsHash"
      ],
      "properties": {
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "fixtureHash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "candidateHash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "controlsHash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hardGate",
        "numericTargets",
        "fullRunAuthorized"
      ],
      "properties": {
        "hardGate": {
          "const": "zero-new-critical-failures"
        },
        "numericTargets": {
          "const": "report-only"
        },
        "fullRunAuthorized": {
          "type": "boolean"
        },
        "fullRunApprovedAt": {
          "type": "string",
          "format": "date-time"
        },
        "fullRunRepetitions": {
          "type": "integer",
          "minimum": 1
        },
        "derivedMargins": {
          "type": "object"
        }
      }
    }
  }
}
