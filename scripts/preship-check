#!/usr/bin/env bash
# Pre-ship hygiene check for harness skills.
# Mechanically runs the validation gates from AGENTS.md and Claude additions.
# Exits non-zero on any FAIL. Run from anywhere in the repo.

set -uo pipefail
repo_root=${PRESHIP_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || echo .)}
cd "$repo_root"

codex_validator=${PRESHIP_CODEX_VALIDATOR:-scripts/validate-codex-plugin}
tailwind_checker=${PRESHIP_TAILWIND_COMMAND:-scripts/tailwind-intellisense-check}
token_audit=${PRESHIP_TOKEN_AUDIT_COMMAND:-scripts/token-audit}

fail=0

# Skills are flat: skills/<name>/SKILL.md, and nothing deeper. Agent Plugins 1.0.0
# section 7.1 fixes discovery at the immediate children of skills/ and states clients
# MUST NOT search deeper, so a grouping folder would make its contents invisible to a
# spec-conformant client. The walk still reaches one level further than that, so a
# nested skill is found and reported by the layout check rather than silently skipped.
skill_dirs() {
  find skills -mindepth 2 -maxdepth 3 -name SKILL.md 2>/dev/null | sed 's#/SKILL\.md$##' | sort
}

# Rules-file authority. AGENTS.md is the shared source; Claude imports it.
echo "Rules authority (AGENTS.md primary; CLAUDE.md imports it):"
rules_fail=0
if [ ! -f AGENTS.md ]; then
  echo "  FAIL: AGENTS.md is missing"
  rules_fail=1
  fail=1
elif ! grep -q '[^[:space:]]' AGENTS.md; then
  echo "  FAIL: AGENTS.md is empty"
  rules_fail=1
  fail=1
elif grep -qx '@CLAUDE.md' AGENTS.md; then
  echo "  FAIL: AGENTS.md imports CLAUDE.md instead of defining the shared rules"
  rules_fail=1
  fail=1
elif [ "$(awk 'NF { count++ } END { print count + 0 }' AGENTS.md)" -lt 2 ]; then
  echo "  FAIL: AGENTS.md must contain substantive shared rules"
  rules_fail=1
  fail=1
fi

if [ ! -f CLAUDE.md ]; then
  echo "  FAIL: CLAUDE.md is missing"
  rules_fail=1
  fail=1
elif [ "$(head -n 1 CLAUDE.md)" != '@AGENTS.md' ]; then
  echo "  FAIL: CLAUDE.md must import AGENTS.md on its first line"
  rules_fail=1
  fail=1
fi
[ "$rules_fail" -eq 0 ] && echo "  OK"

# 1. Loader-trigger byte sequences (AGENTS.md "Authoring footgun").
echo
echo "Loader-trigger sequences (must be empty):"
m1=$(grep -rln $'\x60\x60\x60!' skills/ 2>/dev/null || true)
m2=$(grep -rln $'!\x60' skills/ 2>/dev/null || true)
if [ -n "$m1$m2" ]; then
  echo "  FAIL"
  [ -n "$m1" ] && { echo "    triple-backtick + bang in:"; printf '%s\n' "$m1" | sed 's/^/      /'; }
  [ -n "$m2" ] && { echo "    bang + backtick in:";        printf '%s\n' "$m2" | sed 's/^/      /'; }
  fail=1
else
  echo "  OK"
fi

# 2. Required frontmatter (name + description).
echo
echo "Required frontmatter (name, description):"
fm_fail=0
while IFS= read -r d; do
  md="$d/SKILL.md"
  if ! awk '/^name:/{n=1} /^description:/{de=1} END{exit !(n && de)}' "$md"; then
    echo "  FAIL: $md missing name or description"
    fm_fail=1
    fail=1
  fi
done < <(skill_dirs)
[ "$fm_fail" -eq 0 ] && echo "  OK"

# 2b. Frontmatter conformance (FAIL). The Agent Skills specification permits exactly six
#     keys — name, description, license, compatibility, metadata, allowed-tools — and
#     requires `name` to match the parent directory name. Any other key is a vendor
#     extension that is documented to fail packaging on a vendor that does not define it,
#     so each one is a portability cost taken deliberately. Two are allowlisted here:
#     disable-model-invocation (nothing in the specification expresses the command tier)
#     and argument-hint. A third arriving by copy-paste is what this check catches.
echo
echo "Frontmatter conformance (6 spec keys + 2 allowlisted extensions; name matches directory):"
fmk_fail=0
while IFS= read -r d; do
  md="$d/SKILL.md"
  for k in $(awk '
    BEGIN { c=0 }
    /^---$/ { c++; if (c==2) exit; next }
    c == 1 && /^[a-zA-Z_][a-zA-Z0-9_-]*:/ { sub(/:.*/, ""); print }
  ' "$md"); do
    case "$k" in
      name|description|license|compatibility|metadata|allowed-tools) ;;
      disable-model-invocation|argument-hint) ;;
      *)
        echo "  FAIL: $md declares \"$k\", outside the six spec keys and the two allowlisted extensions"
        fmk_fail=1
        fail=1
        ;;
    esac
  done
  declared=$(awk '
    BEGIN { c=0 }
    /^---$/ { c++; if (c==2) exit; next }
    c == 1 && /^name:/ { sub(/^name:[[:space:]]*/, ""); print; exit }
  ' "$md" | tr -d '\042\047 ')
  if [ "$declared" != "$(basename "$d")" ]; then
    echo "  FAIL: $md declares name \"$declared\" but its directory is \"$(basename "$d")\""
    fmk_fail=1
    fail=1
  fi
done < <(skill_dirs)
[ "$fmk_fail" -eq 0 ] && echo "  OK"

# 3. Description length. Two independent limits enforced:
#    - `description` alone <= 1024 chars: the Agent Skills open-spec hard limit
#      (agentskills.io/specification). Binds cross-harness; skills-ref validate fails past it.
#    - `description` + `when_to_use` <= 1536 chars: Claude Code's skill-listing truncation
#      budget; anything past is silently dropped from the model's catalog. Counts only those
#      two fields, not the full frontmatter (which can hold paths, hooks, harness-targets, etc.).
echo
echo "Description length (spec: <=1024 desc; Claude listing: <=1536 desc+when_to_use):"
while IFS= read -r d; do
  md="$d/SKILL.md"
  combined=$(awk '
    BEGIN { c=0; mode="" }
    /^---$/ { c++; if (c==2) exit; next }
    c != 1 { next }
    /^description:[[:space:]]*\|[[:space:]]*$/ { mode="d"; next }
    /^description:/ { sub(/^description:[[:space:]]*/, ""); print; mode=""; next }
    /^when_to_use:[[:space:]]*\|[[:space:]]*$/ { mode="w"; next }
    /^when_to_use:/ { sub(/^when_to_use:[[:space:]]*/, ""); print; mode=""; next }
    /^[a-zA-Z_][a-zA-Z0-9_-]*:/ { mode=""; next }
    mode != "" { print }
  ' "$md")
  len=$(printf '%s' "$combined" | wc -c | tr -d ' ')
  desc_only=$(awk '
    BEGIN { c=0; mode="" }
    /^---$/ { c++; if (c==2) exit; next }
    c != 1 { next }
    /^description:[[:space:]]*\|[[:space:]]*$/ { mode="d"; next }
    /^description:/ { sub(/^description:[[:space:]]*/, ""); print; mode=""; next }
    /^[a-zA-Z_][a-zA-Z0-9_-]*:/ { mode=""; next }
    mode == "d" { print }
  ' "$md")
  dlen=$(printf '%s' "$desc_only" | wc -c | tr -d ' ')
  flag="OK"
  if [ "$dlen" -gt 1024 ]; then
    flag="OVER — description $dlen > 1024 (Agent Skills spec limit)"
    fail=1
  elif [ "$len" -gt 1536 ]; then
    flag="OVER — combined $len > 1536 (Claude listing truncation)"
    fail=1
  elif [ "$len" -gt 1100 ]; then
    # Advisory only: the cap is a truncation guard, not a target. Past ~1,100
    # the entry is usually padded.
    # Skills with disable-model-invocation never enter the model's listing,
    # so their length costs nothing — no warn.
    if grep -q '^disable-model-invocation:[[:space:]]*true' "$md"; then
      flag="OK (hidden from model listing)"
    else
      flag="warn: >1100 — review for padding"
    fi
  fi
  printf "  %-30s desc %4d/1024  combined %4d/1536  %s\n" "$(basename "$d")" "$dlen" "$len" "$flag"
done < <(skill_dirs)

# 4. Reference orphans: files in references/ not mentioned in SKILL.md.
echo
echo "Reference orphans (in references/ but not pointed at by SKILL.md):"
ref_fail=0
while IFS= read -r d; do
  [ -d "$d/references" ] || continue
  for ref in "$d/references"/*.md; do
    [ -f "$ref" ] || continue
    bn=$(basename "$ref")
    if ! grep -q "references/$bn" "$d/SKILL.md" 2>/dev/null; then
      echo "  ORPHAN: $ref"
      ref_fail=1
      fail=1
    fi
  done
done < <(skill_dirs)
[ "$ref_fail" -eq 0 ] && echo "  OK"

# 5. Dangling references: files mentioned by SKILL.md that don't exist on disk.
echo
echo "Dangling references/templates (mentioned in SKILL.md but missing on disk):"
dangle_fail=0
while IFS= read -r d; do
  md="$d/SKILL.md"
  for ref in $(grep -oE '(references|assets|templates)/[a-zA-Z0-9_.-]+\.md' "$md" | sort -u); do
    if [ ! -f "$d/$ref" ]; then
      echo "  DANGLING: $d/SKILL.md mentions $ref but $d$ref does not exist"
      dangle_fail=1
      fail=1
    fi
  done
done < <(skill_dirs)
[ "$dangle_fail" -eq 0 ] && echo "  OK"

# 5b. Marker integrity for shipped AGENTS.md snippets. A snippet is installed into
#     a consumer repository as a managed block, so it must carry exactly one
#     matching start/end marker pair or an in-place update cannot find its bounds.
echo
echo "AGENTS snippet markers (matched start/end pair per shipped snippet):"
snippet_fail=0
while IFS= read -r snip; do
  [ -n "$snip" ] || continue
  skill_name=$(basename "$(dirname "$(dirname "$snip")")")
  starts=$(grep -cE "^<!--[[:space:]]*${skill_name}:start[[:space:]]*-->$" "$snip" || true)
  ends=$(grep -cE "^<!--[[:space:]]*${skill_name}:end[[:space:]]*-->$" "$snip" || true)
  if [ "$starts" != "1" ] || [ "$ends" != "1" ]; then
    echo "  FAIL: $snip needs exactly one '$skill_name:start' and one '$skill_name:end' marker (found $starts/$ends)"
    snippet_fail=1
    fail=1
  fi
  if ! grep -q "$(basename "$snip")" "$(dirname "$(dirname "$snip")")/SKILL.md"; then
    echo "  FAIL: $snip is not pointed at by its SKILL.md (consumers cannot find it)"
    snippet_fail=1
    fail=1
  fi
done <<EOF
$(find skills -type f -name 'AGENTS.snippet.md' 2>/dev/null)
EOF
[ "$snippet_fail" -eq 0 ] && echo "  OK"

# 6. Claude plugin SHA-versioning guard (FAIL). The Claude manifest uses commit-SHA
#    versioning; the separate Codex manifest intentionally carries strict semver.
echo
echo "Claude plugin SHA-versioning (no version field):"
ver_fail=0
for f in .claude-plugin/plugin.json; do
  [ -f "$f" ] || continue
  if grep -Eq '"version"[[:space:]]*:' "$f"; then
    echo "  FAIL: $f has a \"version\" field — remove it (commit-SHA versioning; a bump re-breaks auto-propagation)"
    ver_fail=1
    fail=1
  fi
done
[ "$ver_fail" -eq 0 ] && echo "  OK"

# 7. Native Codex plugin packaging and cross-harness invocation parity.
echo
echo "Codex plugin packaging:"
if ! "$codex_validator"; then
  fail=1
fi

# 7b. Cross-harness invocation parity (FAIL). AGENTS.md "Authoring rule: invocation
#     tiers": a command-tier skill is manual-only in both harnesses — Claude reads
#     `disable-model-invocation: true` from SKILL.md, Codex reads
#     `policy.allow_implicit_invocation: false` from agents/openai.yaml. One without
#     the other leaves the skill user-only in one harness and implicitly invocable in
#     the other, so both directions FAIL. The Codex validator above also rejects the
#     Claude-set/Codex-missing direction on its own, for standalone runs.
echo
echo "Invocation parity (disable-model-invocation <-> allow_implicit_invocation):"
parity_fail=0
while IFS= read -r d; do
  md="$d/SKILL.md"
  yaml="$d/agents/openai.yaml"
  claude_manual=0
  codex_manual=0
  grep -Eq '^disable[-_]model[-_]invocation:[[:space:]]*true[[:space:]]*$' "$md" && claude_manual=1
  if [ -f "$yaml" ] && grep -Eq '^[[:space:]]*allow_implicit_invocation:[[:space:]]*false[[:space:]]*$' "$yaml"; then
    codex_manual=1
  fi
  if [ "$claude_manual" -eq 1 ] && [ "$codex_manual" -eq 0 ]; then
    echo "  FAIL: $md sets disable-model-invocation: true but $yaml has no policy.allow_implicit_invocation: false"
    parity_fail=1
    fail=1
  elif [ "$codex_manual" -eq 1 ] && [ "$claude_manual" -eq 0 ]; then
    echo "  FAIL: $yaml sets policy.allow_implicit_invocation: false but $md has no disable-model-invocation: true"
    parity_fail=1
    fail=1
  fi
done < <(skill_dirs)
[ "$parity_fail" -eq 0 ] && echo "  OK"

# 8. Machine-scope shadow collisions (advisory; machine-local). CLAUDE.md: a skill name here that
#    collides with a real dir (or a symlink from elsewhere) at ~/.claude/skills/<name> is SHADOWED —
#    personal scope overrides plugin scope, so pushed changes never win in other repos. Same silent
#    propagation break as a pinned "version" field, but machine-local, so it only warns and never
#    fails the commit (CI and other contributors won't have the shadow). Reads ~/.claude, never writes.
echo
echo "Machine-scope shadow collisions (advisory; ~/.claude/skills):"
usk="$HOME/.claude/skills"
if [ ! -d "$usk" ]; then
  echo "  (no ~/.claude/skills; skipping)"
else
  coll=0
  while IFS= read -r d; do
    name=$(basename "$d")
    entry="$usk/$name"
    [ -e "$entry" ] || [ -L "$entry" ] || continue
    # a symlink pointing back into THIS repo is the skill itself, not a foreign shadow
    if [ -L "$entry" ]; then
      case "$(readlink "$entry")" in
        "$PWD"/*) continue ;;
      esac
    fi
    echo "  warn: $name is also at ~/.claude/skills/$name — personal scope shadows the plugin; pushed changes won't win in other repos"
    coll=1
  done < <(skill_dirs)
  [ "$coll" -eq 0 ] && echo "  OK"
fi

# 9. Dangling self-plugin cross-references (FAIL). AGENTS.md "Authoring rule: a skill may name
#    another, in one form only": skills:<name> is the sanctioned form, so a reference to a skill
#    that is not on disk points readers and the loader at nothing (the trap that hid /changelog
#    behind a phantom reference). Bodies and references are both checked, since a reference file
#    can carry the same dead pointer. A bare /name collides with bundled commands
#    (/code-review, /init), which is why it is not the sanctioned form and is not validated here.
echo
echo "Dangling self-plugin cross-references (skills: form, SKILL.md + references):"
xref=0
while IFS= read -r d; do
  for md in "$d/SKILL.md" "$d"/references/*.md; do
    [ -f "$md" ] || continue
    for ref in $(grep -oE 'skills:[a-z0-9][a-z0-9-]*' "$md" 2>/dev/null | sort -u); do
      rname=${ref#*:}
      rfound=0
      for cand in "skills/$rname/SKILL.md" skills/*/"$rname"/SKILL.md; do
        [ -f "$cand" ] && rfound=1
      done
      if [ "$rfound" -eq 0 ]; then
        echo "  FAIL: ${md#./} references $ref but no skills/$rname or skills/*/$rname/SKILL.md exists"
        xref=1
        fail=1
      fi
    done
  done
done < <(skill_dirs)
[ "$xref" -eq 0 ] && echo "  OK"

# 10. Manifest conformance and flat skill layout (FAIL). Agent Plugins 1.0.0 §5.1 puts the
#     portable manifest at root plugin.json, and its schema is closed
#     (additionalProperties: false, required ["$schema", "name"]) — so it carries metadata
#     only and cannot declare a "skills" field. §7.1 fixes discovery at the immediate
#     children of skills/ and states clients MUST NOT search deeper, which is why every
#     skill here is flat and why a grouping folder cannot come back. Cursor reads this
#     manifest; Claude Code reads .claude-plugin/plugin.json and Codex reads
#     .codex-plugin/plugin.json, neither of which documents reading the root one, so all
#     three coexist. Claude's own "skills" field ADDS to its always-on scan of
#     skills/<name>/, so a flat repository needs no entries there — but an entry that is
#     present must still resolve to something.
echo
echo "Manifest conformance (root plugin.json, Agent Plugins 1.0.0) and flat skill layout:"
man_fail=0

while IFS= read -r d; do
  case "${d#skills/}" in
    */*)
      echo "  FAIL: $d/SKILL.md is nested; Agent Plugins 1.0.0 section 7.1 forbids discovery below skills/<name>/"
      man_fail=1
      fail=1
      ;;
  esac
done < <(skill_dirs)

root_man="plugin.json"
if [ ! -f "$root_man" ]; then
  echo "  FAIL: missing $root_man — the portable manifest Cursor and any future spec client read"
  man_fail=1
  fail=1
else
  if ! python3 - "$root_man" <<'PY'
import json, sys

ALLOWED = {"$schema", "name", "version", "description", "author",
           "homepage", "repository", "license", "keywords", "extensions"}
SCHEMA = "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json"

path = sys.argv[1]
try:
    with open(path) as fh:
        manifest = json.load(fh)
except (OSError, ValueError) as exc:
    print(f"  FAIL: {path} is not valid JSON: {exc}")
    sys.exit(1)

bad = 0
if manifest.get("$schema") != SCHEMA:
    print(f'  FAIL: {path} "$schema" must be exactly {SCHEMA}')
    bad = 1
if not isinstance(manifest.get("name"), str) or not manifest["name"]:
    print(f'  FAIL: {path} needs a non-empty string "name"')
    bad = 1
for key in manifest:
    if key in ALLOWED:
        continue
    if key == "skills":
        print(f'  FAIL: {path} must not declare "skills" — discovery is fixed at skills/<name>/ by section 7.1')
    else:
        print(f'  FAIL: {path} has unknown top-level key "{key}"; the schema sets additionalProperties: false')
    bad = 1
if "version" in manifest:
    print(f'  warn: {path} carries "version". No client that reads it pins on version today, but the'
          " Claude manifest is deliberately versionless because pinning silently stops propagation.")
sys.exit(bad)
PY
  then
    man_fail=1
    fail=1
  fi
fi

man=".claude-plugin/plugin.json"
if [ ! -f "$man" ]; then
  echo "  FAIL: missing $man"
  man_fail=1
  fail=1
else
  for p in $(grep -oE '"\./skills/[a-zA-Z0-9/_-]+"' "$man" | tr -d '"'); do
    case "$p" in
      */)
        if [ ! -d "$p" ]; then
          echo "  FAIL: $man lists $p but that directory does not exist"
          man_fail=1
          fail=1
        fi
        ;;
      *)
        if [ ! -f "$p/SKILL.md" ]; then
          echo "  FAIL: $man lists $p but $p/SKILL.md does not exist"
          man_fail=1
          fail=1
        fi
        ;;
    esac
  done
fi

[ "$man_fail" -eq 0 ] && echo "  OK"

# 11. Tailwind IntelliSense diagnostics in Markdown code examples (FAIL).
#     Uses the same official language server as the Cursor/VS Code Problems panel.
echo
echo "Tailwind IntelliSense (all skill Markdown examples):"
if ! "$tailwind_checker"; then
  fail=1
fi

# 12. Changed-skill static token report (advisory, zero-model).
#     This command can report structural growth and review thresholds, but it
#     cannot establish runtime token savings or quality parity. Dynamic
#     evaluation is never called by this gate.
echo
echo "Token efficiency (changed skills; advisory, zero-model):"
token_audit_args=(--scope changed)
if [ -n "${PRESHIP_TOKEN_AUDIT_BASE:-}" ]; then
  token_audit_args+=(--base "$PRESHIP_TOKEN_AUDIT_BASE")
fi
if [ ! -x "$token_audit" ]; then
  echo "  warn: $token_audit is unavailable; changed-skill token report was not run."
elif ! "$token_audit" "${token_audit_args[@]}"; then
  echo "  warn: changed-skill token reporting did not complete; see diagnostics above."
fi

echo
if [ "$fail" -ne 0 ]; then
  echo "FAILED — see above." >&2
  exit 1
fi
echo "OK — safe to ship."
